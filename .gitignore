.env
data/pg/
data/bronze/
ops/audit/stats.ndjson
ops/audit/pull.log
__pycache__/
*.pyc
.venv/

# ── Secrets. These were NOT covered and would have gone into history ──────────
# `.env` was ignored; its timestamped backups were not, and they contain the
# same DB password, Telegram api_hash and FIRMS key in full.
.env.bak-*
.env.*.bak

# The Telegram session IS the account's auth key. Committing it would put the
# scarcest asset in the project into git history, where deleting the file later
# does not remove it. Two clients sharing one session can also invalidate the
# account outright.
data/session/

# Operational output, not source: regenerated every run, grows without bound,
# and reviewing a diff of it tells you nothing.
ops/alerts.ndjson
ops/accuracy.ndjson
# Also: it is a record of what strangers asked a checkpoint service, and that
# does not belong in a repository that might one day be published.
ops/mcp-usage.ndjson
ops/mcp-usage.ndjson.1
ops/reliability.ndjson
ops/crowd_independence.ndjson
ops/backup-status.json
ops/api.log
ops/dualrun/

# The weekly maintenance run's transcript. Same class as the .env backups
# above: the file records every command an unattended agent ran and everything
# those commands printed, it rotates on its own (12 kept), and nobody reviews
# it in a diff. It arrived with the maintain feature and was uncovered.
ops/maintain-logs/
data/gap-radar.json
data/gaza-crosscheck.json
data/source-scout.json
data/scout-state.json
data/evidence/

# equivalence row dumps: the debugging aid, not the reviewed claim (manifest.json is)
ops/equivalence/*.json.gz
# same split for the v1 cuts: the before-state is scratch, report.json is the record
ops/cuts/*.json.gz

# open-data release payload: regenerate with ops/export_open_data.py
data/open-release/by-source/
data/open-release/*.csv.gz

# fetched corpora: regenerate with ops/fetch_t4p.py (14 MB, changes daily)
data/raw/tech4palestine/
data/raw/ooni/
data/raw/ioda/
