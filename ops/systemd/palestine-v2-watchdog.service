[Unit]
Description=Palestine v2 — watchdog over every job and feed (P3.1)
After=docker.service
OnFailure=palestine-v2-alert@%n.service

[Service]
Type=oneshot
User=zaid
WorkingDirectory=/home/zaid/palestine-v2
ExecStart=/home/zaid/palestine-v2/ops/watchdog.sh
TimeoutStartSec=300
# No SuccessExitStatus. It read `0 1` because the watchdog exited 1 when it
# FOUND a fault — and 1 is also Python's exit on any crash, so a watchdog that
# died mid-run was recorded as a success and OnFailure could never fire.
# ops/watchdog.sh now exits 0 for "ran, found faults" (the watchdog raised
# them itself) and 70 for "did not finish", so the default — only 0 is
# success — is exactly right, and a crash alarms.
