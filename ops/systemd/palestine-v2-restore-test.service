[Unit]
Description=Palestine v2 — weekly restore test from the OFF-SITE copy
After=docker.service
Requires=docker.service
OnFailure=palestine-v2-alert@%n.service

[Service]
Type=oneshot
User=zaid
WorkingDirectory=/home/zaid/palestine-v2
ExecStart=/home/zaid/palestine-v2/ops/restore-test.sh
TimeoutStartSec=3600
