[Unit]
Description=Palestine v2 — Telegram poller (agent2 account)
After=network-online.target docker.service
# NO START LIMIT, and this is a deliberate reversal of the rule that was here.
#
# It read StartLimitIntervalSec=600 / StartLimitBurst=3, to stop a restart storm
# hammering Telegram — agent2 is new and rate-limit fragile, and that concern is
# still right. But paired with RestartSec=60 it meant three minutes of network
# trouble killed the poller PERMANENTLY. On 2026-08-02 at 14:10 the transport
# failed five times, systemd tried three restarts, logged "Start request
# repeated too quickly", and gave up. The poller stayed dead for SEVENTEEN
# HOURS.
#
# Everything downstream behaved exactly as designed and none of it helped. The
# unit exited non-zero instead of idling with a dead transport (the 2026-08-01
# fix). OnFailure fired the alarm three times. The watchdog reported
# `not_running` for 1,051 minutes. The system knew perfectly well; nobody was
# listening. Detection was never the missing piece.
#
# The danger was never retrying — it was retrying FAST. So retry forever and
# back off instead. RestartSteps turns a blip into a 30-second recovery and a
# real outage into one connection attempt every fifteen minutes, which is
# gentler on Telegram than this poller's own 30-second polling cycle when it is
# perfectly healthy. Permanent death is not the cautious option here; it is the
# one that silently loses a day.
#
# The case where stopping IS correct is still handled, in watchdog.conf:
# RestartPreventExitStatus=2 means an unauthorised session halts immediately,
# because reconnecting a dead session is the one pattern that actually
# endangers the account.
StartLimitIntervalSec=0

[Service]
Type=simple
User=zaid
WorkingDirectory=/home/zaid/palestine-v2
ExecStart=/home/zaid/palestine-v2/.venv/bin/python -m ingest.telegram_poller
Restart=on-failure

# Exponential backoff, systemd >= 254 (this host runs 255): 30s doubling across
# five steps to the 15-minute ceiling, then holding there for as long as the
# outage lasts.
RestartSec=30
RestartSteps=5
RestartMaxDelaySec=900

[Install]
WantedBy=multi-user.target
