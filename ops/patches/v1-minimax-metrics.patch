-                "enabled": self.enabled, "model": self.model}
+                "enabled": self.enabled, "model": self.model,
+                "ok": self._ok, "failed": self._fail,
+                # None, not 1.0 and not 0.0: a rate over no calls is unknown,
+                # and a confident number here would be the same lie one layer
+                # further in.
+                "success_rate": (round(self._ok / attempted, 4)
+                                 if attempted else None),
+                "failure_reasons": dict(self._fail_reasons),
+                "last_ok_at": self._last_ok_at,
+                "last_error": self._last_error}
+
+    def _record(self, ok: bool, reason: str = "") -> None:
+        from datetime import datetime as _dt
+        if ok:
+            self._ok += 1
+            self._last_ok_at = _dt.utcnow().isoformat()
+            return
+        self._fail += 1
+        key = (reason or "unknown")[:120]
+        self._fail_reasons[key] = self._fail_reasons.get(key, 0) + 1
+        self._last_error = key
 
