+        # WHY THESE EXIST (added 2026-09-19 after the audit in
+        # ~/lifeos-kernel/docs/LOCAL-ANALYST-2026-09.md §0).
+        # This client failed 29,686 of its last 29,687 calls and nothing said
+        # so for three months. It was not hidden: every failure logged "falling
+        # back to rules", truthfully. What was missing was a DENOMINATOR —
+        # `stats()` reported calls_today and nothing about whether any of them
+        # worked, so "degrading" and "stone dead" produced identical evidence
+        # on every surface this service has. A counter is the whole fix.
+        self._ok = 0
+        self._fail = 0
+        self._fail_reasons: dict = {}
+        self._last_ok_at: Optional[str] = None
+        self._last_error: Optional[str] = None
 
     # ── budget (in-process soft cap; resets daily / on restart) ──────────────
